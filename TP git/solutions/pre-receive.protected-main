#!/bin/bash
# Simule la règle de protection de la branche 'main' (TP 2.1 Étape 9) :
# - refuse un push direct sauf si ALLOW_PROTECTED_MERGE=1 (merge PR validé)
# - refuse tout force-push (non fast-forward) sur refs/heads/main
while read oldrev newrev refname; do
    if [ "$refname" = "refs/heads/main" ]; then
        if [ "$oldrev" != "0000000000000000000000000000000000000000" ] && \
           [ "$newrev" != "0000000000000000000000000000000000000000" ]; then
            if ! git merge-base --is-ancestor "$oldrev" "$newrev" 2>/dev/null; then
                echo "❌ [Protection main] Force-push interdit sur refs/heads/main !"
                exit 1
            fi
        fi
        if [ "${ALLOW_PROTECTED_MERGE:-0}" != "1" ]; then
            echo "❌ [Protection main] Push direct sur 'main' refusé : passez par une Pull Request !"
            exit 1
        fi
    fi
done
exit 0
