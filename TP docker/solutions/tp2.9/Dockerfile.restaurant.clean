# TP 2.9 - Étape 6 : Dockerfile corrigé sans avertissement Hadolint (DL3008 / DL3009 résolus)
FROM ubuntu:22.04
LABEL maintainer="Legeni"

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    nginx=1.18.0-6ubuntu14.22 \
    git=1:2.34.1-1ubuntu1.18 \
    ca-certificates=20260816ubuntu0.22.04.2 \
 && rm -rf /var/lib/apt/lists/* /var/www/html/* \
 && git clone --depth 1 https://github.com/Legeni07/restaurant.git /var/www/html/ \
 && rm -rf /var/www/html/.git

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
