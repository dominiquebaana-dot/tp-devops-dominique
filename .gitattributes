# Enforce LF line endings for all text files
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.j2 text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env* text eol=lf
Jenkinsfile* text eol=lf
Dockerfile* text eol=lf
VERSION text eol=lf
